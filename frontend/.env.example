# Base URL of the REST API. In development "/api" is proxied to the backend by Vite.
# In production set the full URL, e.g. https://api.yourstore.com/api
VITE_API_URL=/api
# Used for canonical URLs and Open Graph tags
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=Aurum Jewelry
# Backend origin used by the Vite dev proxy
VITE_PROXY_TARGET=http://localhost:5000
