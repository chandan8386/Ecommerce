# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of this API (used for local image URLs and the sitemap)
API_URL=http://localhost:5000
# Comma-separated list of allowed browser origins (storefront + admin)
CLIENT_URLS=http://localhost:5173,http://localhost:5174
# Storefront URL (used in sitemap.xml)
STORE_URL=http://localhost:5173

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/aurum_jewelry

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@aurum.com
SEED_ADMIN_PASSWORD=Admin@12345

# ---------- Cloudinary (optional) ----------
# If these are empty, images are stored on local disk in /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aurum-jewelry

# ---------- Razorpay ----------
# Test keys from https://dashboard.razorpay.com/app/keys
# If empty (and NODE_ENV != production) a mock payment gateway is used for demos.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Commerce ----------
CURRENCY=INR
# Tax rate in percent applied to (subtotal - discount)
TAX_RATE=3
SHIPPING_FEE=99
FREE_SHIPPING_THRESHOLD=999
# Minutes before an unpaid online order is cancelled and its stock released
PENDING_ORDER_TTL_MINUTES=30
